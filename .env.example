# Copy to .env.local and fill in values.

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (https://supabase.com/dashboard → your project → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=your_api_key_here

# --- Google Gemini (RAG query embedding) ---
# Get from: https://aistudio.google.com/app/apikey
# Used ONLY to embed user queries for semantic search against Supabase vectors.
# Document embeddings are already in Supabase (created separately).
# Without this key the app falls back to static knowledge injection (no RAG).
GEMINI_API_KEY=

# Optional: specify the embedding model (defaults to gemini-embedding-001)
# Must match the vector dimensions of your knowledge_embeddings table:
#   - gemini-embedding-001 (768 dims)
#   - text-embedding-3-small (384 dims)
#   - text-embedding-3-large (3072 dims)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: log each RAG chunk (source, similarity, text preview) to the server console
# RAG_DEBUG=1

# --- SendGrid (invite, outreach, closed-loop; must match a verified sender in SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# App URL (for email links and server-side fetches)
NEXT_PUBLIC_URL=http://localhost:3000

# --- Platform admin UI (/platform/onboard) — comma-separated Clerk primary emails ---
PLATFORM_ADMIN_EMAILS=admin@softway.com

# --- HR / provision API (server-only; for scripts / CI — not shown in the browser UI) ---
# Generate once: openssl rand -hex 32
PROVISION_API_SECRET=
